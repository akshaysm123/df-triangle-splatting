#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=dftri_train
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=output/DFTRI_output%A.out

set -e
source $HOME/miniconda3/start1260.sh
conda activate triangle_splatting
(
    cd $HOME/df-triangle-splatting

    # rebuild
    pushd submodules/diff-triangle-rasterization/
    pip install --no-build-isolation --upgrade .
    popd
    echo -e "\nFinished building, starting training.\n"

    SCENE="bicycle"
    # Schedules tied to the 5000-iteration run: LR decays fully, densification stops
    # at 80% so the final pruning pass runs. depth_ratio 0 = expected depth
    # (recommended for unbounded outdoor scenes; use 1 for bounded/indoor).
    python train.py -s $HOME/mipnerf/$SCENE -m output/m360/$SCENE --iterations 5000 \
        --position_lr_max_steps 5000 --densify_until_iter 4000 \
        --test_iterations 1000 2500 5000 --depth_ratio 0
    python render.py -m output/m360/$SCENE --quick
)