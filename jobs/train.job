#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=dftri_train
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=output/DFTRI_output%A.out

set -e
source $HOME/miniconda3/start1260.sh
conda activate triangle_splatting
(
    cd $HOME/df-triangle-splatting

    # rebuild
    pushd submodules/diff-triangle-rasterization/
    pip install --no-build-isolation --upgrade .
    popd
    echo -e "\nFinished building, starting training.\n"

    SCENE="bicycle"
    # Full 30k run: the schedule defaults (position_lr_max_steps 30000,
    # densify_until_iter 25000, test_iterations 7000/30000, dist/normal warmups)
    # already match. depth_ratio 0 = expected depth (recommended for unbounded
    # outdoor scenes; use 1 for bounded/indoor).
    python train.py -s $HOME/mipnerf/$SCENE -m output/m360/$SCENE \
        --iterations 30000 \
        --depth_ratio 1.0 \
        --densify_error_beta 3.0 \
        --densify_normal_beta 3.0 \
        --split_normal_threshold 0.5 \
        --outdoor
    # python render.py -m output/m360/$SCENE --quick
)