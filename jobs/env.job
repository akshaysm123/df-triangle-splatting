#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=dftri_env
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=output/DFTRI_output%A.out

source $HOME/miniconda3/start1260.sh

#create/activate env
pushd $HOME/df-triangle-splatting/ || exit 1
conda env create -f requirements.yaml
conda activate triangle_splatting

# install submodules
pushd submodules/simple-knn/ || exit 1
pip install --no-build-isolation .
popd

pushd submodules/diff-triangle-rasterization/ || exit 1
pip install --no-build-isolation .
popd

popd