#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=dftri_seed_growth
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=output/DFTRI_seed_growth_%A.out

set -e
source $HOME/miniconda3/start1260.sh
conda activate triangle_splatting
(
    cd $HOME/df-triangle-splatting

    # rebuild the CUDA rasterizer (surface_id channel etc.)
    pushd submodules/diff-triangle-rasterization/
    pip install --no-build-isolation --upgrade .
    popd
    echo -e "\nFinished building, starting training.\n"

    SCENE="garden"

    # New additions (see notes/depth_seeding_and_growth.md):
    #   --init_mode depth        : seed triangles by back-projecting the DA3 depth
    #                              maps (geometry-uniform, surface-oriented) instead
    #                              of one randomly-oriented triangle per SfM point.
    #   --init_shapes 60000      : explicit seed-count target N_0 (below the ~200k
    #                              post-densification survivors so growth fills in).
    #   --densify_need_gate 1.0  : scale per-event growth by remaining interval
    #                              error so the count plateaus near the survivor
    #                              level instead of overshooting (~600k churn peak).
    #                              Needs an error channel populated -> betas > 0.
    #   --lambda_mask 0.01       : learnable-mask sparsity. L1 on the soft mask
    #                              drives unneeded primitives off; masked-off ones
    #                              are pruned. Principal lever for FEWER final
    #                              primitives. Also unfreezes the mask lr.
    # The error-aware sampling / split routing (betas, split_normal_threshold) are
    # the prerequisites that populate the depth/normal error buffers.
    python train.py \
        -s $HOME/mipnerf/$SCENE \
        -m output/m360_seed_growth/$SCENE \
        --iterations 30000 \
        --depth_ratio 0.5 \
        --init_mode depth \
        --init_shapes 60000 \
        --densify_need_gate 0.0 \
        --densify_error_beta 3.0 \
        --densify_normal_beta 3.0 \
        --split_normal_threshold 0.5 \
        --lambda_mask 0.01 \
        --lambda_normals 0 \
        --outdoor
    # python render.py -m output/m360_seed_growth/$SCENE --quick
)
